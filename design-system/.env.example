# Copy to .env.local for development, or set these in your hosting
# provider's project settings for production. No live values are
# checked into the repository.

# --- Required: Supabase project (Phase 2/3 database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Required: canonical site URL, used for canonical links, hreflang,
#     OpenGraph, and the sitemap. No trailing slash. ---
NEXT_PUBLIC_SITE_URL=https://cyberabeer.com

# --- Optional: rate limiting for public forms. Forms fail open (no
#     limit enforced) if these are not set. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: analytics. If unset, the analytics script is not
#     injected and window.plausible calls are no-ops. ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=cyberabeer.com

# --- Optional: transactional email (lib/email/send.ts), used for the
#     welcome email, enterprise enquiry confirmation, and GreenTrust
#     assessment result emails. Server-only; never exposed to the
#     browser. If unset, sendEmail() logs and no-ops instead of
#     throwing, so the app still runs without it configured. Account
#     confirmation and password-reset emails are NOT covered by this:
#     those are sent natively by Supabase Auth (configure their sender
#     and templates in the Supabase project's Auth settings instead). ---
RESEND_API_KEY=
# Must be a domain verified in your Resend account. Falls back to
# Resend's shared onboarding@resend.dev sandbox sender if unset, which
# is fine for testing but should not be used in production.
EMAIL_FROM_ADDRESS="CyberAbeer <hello@cyberabeer.com>"
